server {
    server_name goldfishstudy.app www.goldfishstudy.app;

    # Site op /, app op /app/ — zie goldfish-site.conf.
    include /etc/nginx/snippets/goldfish-site.conf;

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/goldfishstudy.app/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/goldfishstudy.app/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.goldfishstudy.app) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = goldfishstudy.app) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name goldfishstudy.app www.goldfishstudy.app;
    return 404; # managed by Certbot




}
